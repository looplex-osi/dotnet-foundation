# Database Configuration
ConnectionStrings:RoutingDatabaseConnectionString=

# JWT Configuration
Audience=
Issuer=
TokenExpirationTimeInMinutes=60

# OIDC Configuration
OicdAudience=
OicdIssuer=
OicdTenantId=
OicdUserInfoEndpoint=https://graph.microsoft.com/oidc/userinfo

# Security Keys (Base64 encoded)
PublicKey=
PrivateKey=

# Client Secret Configuration
ClientSecretByteLength=72
ClientSecretDigestCost=4

# Telemetry Configuration
TELEMETRY_PROVIDER=
TELEMETRY_SERVICE_NAME=
TELEMETRY_SERVICE_VERSION=
TELEMETRY_ENVIRONMENT=

# OpenTelemetry Configuration
OTEL_ENDPOINT=http://localhost:4317
OTEL_EXPORT_PROTOCOL=otlp
OTEL_ENABLE_CONSOLE_EXPORTER=true
OTEL_SAMPLE_RATE=1.0
OTEL_ENABLE_HTTP_INSTRUMENTATION=true
OTEL_ENABLE_SQL_INSTRUMENTATION=true
OTEL_ENABLE_REDIS_INSTRUMENTATION=false
OTEL_ENABLE_PLUGINS_INSTRUMENTATION=true

# Application Insights Configuration (if using ApplicationInsights provider)
# APPLICATIONINSIGHTS_CONNECTIONSTRING=your_connection_string_here
# APPLICATIONINSIGHTS_INSTRUMENTATION_KEY=your_instrumentation_key_here

# DataDog Configuration (if using DataDog provider)
# DATADOG_API_KEY=your_api_key_here
# DATADOG_SITE=datadoghq.com
# DATADOG_SERVICE=notejam

# Global Attributes (comma-separated key=value pairs)
# TELEMETRY_GLOBAL_ATTRIBUTES=tenant=default,region=us-east-1
 